# Gemini AI API Key (for site explanations, questionnaire parsing, and comparison)
GEMINI_API_KEY=

# OpenAQ API Key (for real air quality stations in India: https://openaq.org)
OPENAQ_API_KEY=

# OpenRouteService API Key (optional fallback if public Valhalla is unreachable)
ORS_API_KEY=

# Data directory path (defaults to ./data)
DATA_DIR=./data

# Allowed CORS origins
CORS_ORIGINS=http://localhost:8080,http://localhost:5173,http://127.0.0.1:8080,http://127.0.0.1:5173
